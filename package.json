{
  "name": "jev-evaluation-lab",
  "version": "0.0.0",
  "description": "Independent TypeSafe Jev evaluation workspace with offline comparison and human review",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "classify": "node scripts/classify.js",
    "test": "node --import tsx --import ./test-support/offline.js --test test/*.test.js test/*.test.tsx",
    "test:browser": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@typesafe-ai/sdk": "^0.7.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
